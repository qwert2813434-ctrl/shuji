25, 1.838], ["待", 1.85, 2.038], ["人", 2.062, 2.213], ["和善的", 2.263, 2.75], ["心", 2.763, 3.0]]}, {"s": "他把一家人帶得像父親照顧孩子。", "start": 133.892, "end": 136.605, "w": [["他", 0.0, 0.225], ["把", 0.225, 0.4], ["一家人", 0.4, 0.825], ["帶", 0.888, 1.05], ["得", 1.062, 1.175], ["像", 1.188, 1.35], ["父親", 1.412, 1.713], ["照顧", 1.825, 2.125], ["孩子", 2.162, 2.713]]}, {"s": "他穩重卻不做作，容得下沒知識的人。", "start": 137.505, "end": 140.692, "w": [["他", 0.0, 0.213], ["穩重", 0.213, 0.562], ["卻", 0.625, 0.8], ["不", 0.825, 0.912], ["做作", 0.95, 1.463], ["容", 1.725, 1.887], ["得", 1.925, 2.025], ["下", 2.037, 2.25], ["沒", 2.25, 2.375], ["知識的", 2.438, 2.925], ["人", 2.925, 3.188]]}, {"s": "他有辦法配合每個人，相處起來比奉承還舒服。", "start": 141.667, "end": 145.705, "w": [["他", 0.0, 0.2], ["有", 0.2, 0.35], ["辦法", 0.363, 0.75], ["配合", 0.762, 1.1], ["每個", 1.113, 1.4], ["人", 1.4, 1.7], ["相處", 2.037, 2.4], ["起來", 2.412, 2.75], ["比", 2.8, 2.912], ["奉承", 2.938, 3.312], ["還", 3.338, 3.475], ["舒服", 3.488, 4.037]]}, {"s": "他從不發脾氣，不被情緒牽著走，卻對人很有感情。", "start": 146.58, "end": 151.08, "w": [["他", 0.0, 0.2], ["從不", 0.2, 0.525], ["發脾氣", 0.537, 1.287], ["不", 1.525, 1.65], ["被", 1.662, 1.787], ["情緒", 1.8, 2.1], ["牽", 2.15, 2.325], ["著", 2.388, 2.525], ["走", 2.575, 2.863], ["卻", 3.162, 3.312], ["對", 3.325, 3.475], ["人", 3.475, 3.638], ["很", 3.675, 3.8], ["有", 3.85, 3.95], ["感情", 3.988, 4.5]]}]}, {"t": "文法學家亞歷山大教我，不要愛挑毛病。有人用字粗俗、不合文法，也別擺出責備的樣子。要很有技巧地，在回答或討論時，順帶把正確講法帶進來。弗朗托讓我看清楚，暴君身上的嫉妒、兩面手法跟虛偽長什麼樣。我也看到，我們這些貴族普遍比較缺乏父母的慈愛。", "src": [10, 11], "start": 152.055, "end": 178.117, "sents": [{"s": "文法學家亞歷山大教我，不要愛挑毛病。", "start": 152.055, "end": 155.367, "w": [["文法", 0.0, 0.363], ["學家", 0.375, 0.775], ["亞歷山大", 0.775, 1.463], ["教", 1.488, 1.638], ["我", 1.663, 1.963], ["不要", 2.188, 2.475], ["愛", 2.488, 2.65], ["挑", 2.7, 2.863], ["毛病", 2.875, 3.312]]}, {"s": "有人用字粗俗、不合文法，也別擺出責備的樣子。", "start": 156.267, "end": 160.442, "w": [["有人", 0.0, 0.3], ["用", 0.363, 0.513], ["字", 0.562, 0.675], ["粗俗", 0.688, 1.3], ["不合", 1.488, 1.812], ["文法", 1.825, 2.338], ["也", 2.575, 2.688], ["別", 2.725, 2.85], ["擺出", 2.863, 3.225], ["責備的", 3.275, 3.65], ["樣子", 3.688, 4.175]]}, {"s": "要很有技巧地，在回答或討論時，順帶把正確講法帶進來。", "start": 161.355, "end": 166.455, "w": [["要", 0.0, 0.175], ["很", 0.2, 0.338], ["有", 0.387, 0.5], ["技巧", 0.562, 0.9], ["地", 0.95, 1.213], ["在", 1.5, 1.613], ["回答", 1.65, 1.975], ["或", 2.0, 2.162], ["討論", 2.175, 2.5], ["時", 2.537, 2.912], ["順帶", 3.2, 3.562], ["把", 3.575, 3.725], ["正確", 3.762, 4.05], ["講法", 4.075, 4.463], ["帶", 4.475, 4.588], ["進", 4.625, 4.713], ["來", 4.787, 5.1]]}, {"s": "弗朗托讓我看清楚，暴君身上的嫉妒、兩面手法跟虛偽長什麼樣。", "start": 167.392, "end": 173.105, "w": [["弗", 0.0, 0.175], ["朗", 0.225, 0.363], ["托", 0.425, 0.6], ["讓", 0.613, 0.725], ["我", 0.75, 0.875], ["看清楚", 0.925, 1.638], ["暴君", 1.838, 2.188], ["身上的", 2.225, 2.725], ["嫉妒", 2.763, 3.238], ["兩", 3.537, 3.713], ["面", 3.713, 3.863], ["手法", 3.888, 4.3], ["跟", 4.312, 4.438], ["虛偽", 4.475, 4.838], ["長", 4.875, 5.075], ["什麼", 5.1, 5.375], ["樣", 5.438, 5.713]]}, {"s": "我也看到，我們這些貴族普遍比較缺乏父母的慈愛。", "start": 174.08, "end": 178.117, "w": [["我", 0.0, 0.15], ["也", 0.162, 0.275], ["看到", 0.325, 0.812], ["我們", 1.062, 1.287], ["這些", 1.325, 1.575], ["貴族", 1.638, 1.938], ["普遍", 1.95, 2.338], ["比較", 2.388, 2.675], ["缺乏", 2.7, 3.088], ["父母的", 3.088, 3.513], ["慈愛", 3.525, 4.037]]}]}, {"t": "柏拉圖學派的亞歷山大教我，不要動不動就跟人說我沒空。也不要老拿事情忙當藉口，推掉本來該盡的責任。卡圖盧斯教我，朋友對我有意見，別冷淡以對。就算他毫無道理怪我，也要試著讓他回到好脾氣。他也要我樂於稱讚自己的老師，真心去愛我的孩子。", "src": [12, 13], "start": 179.08, "end": 203.755, "sents": [{"s": "柏拉圖學派的亞歷山大教我，不要動不動就跟人說我沒空。", "start": 179.08, "end": 183.767, "w": [["柏", 0.0, 0.162], ["拉圖", 0.175, 0.513], ["學派的", 0.513, 1.013], ["亞歷山大", 1.037, 1.725], ["教", 1.75, 1.9], ["我", 1.925, 2.213], ["不要", 2.475, 2.725], ["動不動", 2.775, 3.263], ["就", 3.35, 3.475], ["跟", 3.525, 3.65], ["人", 3.688, 3.8], ["說", 3.838, 4.088], ["我", 4.088, 4.213], ["沒空", 4.225, 4.688]]}, {"s": "也不要老拿事情忙當藉口，推掉本來該盡的責任。", "start": 184.68, "end": 188.605, "w": [["也", 0.0, 0.15], ["不要", 0.2, 0.475], ["老", 0.475, 0.613], ["拿", 0.638, 0.8], ["事情", 0.8, 1.138], ["忙", 1.175, 1.325], ["當", 1.388, 1.525], ["藉口", 1.575, 2.088], ["推掉", 2.388, 2.675], ["本來", 2.7, 2.988], ["該", 3.038, 3.15], ["盡的", 3.175, 3.425], ["責任", 3.438, 3.925]]}, {"s": "卡圖盧斯教我，朋友對我有意見，別冷淡以對。", "start": 189.593, "end": 193.63, "w": [["卡", 0.0, 0.212], ["圖", 0.237, 0.4], ["盧斯", 0.45, 0.737], ["教", 0.787, 0.975], ["我", 1.0, 1.312], ["朋友", 1.562, 1.875], ["對", 1.938, 2.012], ["我", 2.062, 2.188], ["有", 2.212, 2.325], ["意見", 2.362, 2.837], ["別", 3.137, 3.262], ["冷淡", 3.3, 3.6], ["以", 3.612, 3.688], ["對", 3.775, 4.037]]}, {"s": "就算他毫無道理怪我，也要試著讓他回到好脾氣。", "start": 194.58, "end": 198.68, "w": [["就算", 0.0, 0.375], ["他", 0.412, 0.575], ["毫無", 0.625, 0.912], ["道理", 0.963, 1.238], ["怪", 1.3, 1.488], ["我", 1.525, 1.812], ["也", 2.075, 2.175], ["要", 2.2, 2.325], ["試", 2.338, 2.45], ["著", 2.475, 2.662], ["讓", 2.662, 2.825], ["他", 2.85, 3.013], ["回到", 3.037, 3.338], ["好", 3.363, 3.525], ["脾氣", 3.55, 4.1]]}, {"s": "他也要我樂於稱讚自己的老師，真心去愛我的孩子。", "start": 199.605, "end": 203.755, "w": [["他", 0.0, 0.188], ["也", 0.188, 0.338], ["要", 0.363, 0.512], ["我", 0.525, 0.637], ["樂於", 0.675, 0.938], ["稱讚", 0.963, 1.325], ["自己的", 1.387, 1.762], ["老師", 1.775, 2.338], ["真心", 2.65, 2.9], ["去", 2.988, 3.125], ["愛", 3.137, 3.312], ["我的", 3.338, 3.588], ["孩子", 3.6, 4.15]]}]}, {"t": "我兄弟塞維魯斯教我，要愛親人、愛真理、愛正義。透過他，我認識了特拉塞亞、卡圖、布魯圖斯這些人。也是從他，我得到一個念頭：好的政體，該對所有人用同一套法律。它講究權利平等，講話的自由也一樣平等。而最好的王道，最看重的就是被統治者的自由。", "src": [14, 14], "start": 204.655, "end": 231.105, "sents": [{"s": "我兄弟塞維魯斯教我，要愛親人、愛真理、愛正義。", "start": 204.655, "end": 209.442, "w": [["我", 0.0, 0.137], ["兄弟", 0.162, 0.525], ["塞", 0.55, 0.75], ["維", 0.775, 0.925], ["魯", 0.962, 1.112], ["斯", 1.125, 1.287], ["教", 1.312, 1.525], ["我", 1.55, 1.85], ["要", 2.137, 2.25], ["愛", 2.262, 2.387], ["親人", 2.412, 2.912], ["愛", 3.237, 3.337], ["真理", 3.4, 3.875], ["愛", 4.162, 4.275], ["正義", 4.325, 4.787]]}, {"s": "透過他，我認識了特拉塞亞、卡圖、布魯圖斯這些人。", "start": 210.38, "end": 215.067, "w": [["透過", 0.0, 0.338], ["他", 0.387, 0.725], ["我", 0.925, 1.05], ["認識", 1.075, 1.325], ["了", 1.375, 1.5], ["特拉塞", 1.537, 2.05], ["亞", 2.088, 2.4], ["卡圖", 2.7, 3.225], ["布", 3.475, 3.588], ["魯", 3.625, 3.725], ["圖", 3.762, 3.912], ["斯", 3.925, 4.088], ["這些", 4.1, 4.45], ["人", 4.463, 4.688]]}, {"s": "也是從他，我得到一個念頭：好的政體，該對所有人用同一套法律。", "start": 216.08, "end": 221.817, "w": [["也是", 0.0, 0.325], ["從", 0.35, 0.537], ["他", 0.6, 0.938], ["我", 1.138, 1.25], ["得到", 1.312, 1.575], ["一個", 1.575, 1.763], ["念頭", 1.775, 2.312], ["好的", 2.625, 2.888], ["政體", 2.938, 3.45], ["該", 3.775, 3.9], ["對", 3.925, 4.025], ["所有人", 4.05, 4.513], ["用", 4.588, 4.688], ["同", 4.738, 4.938], ["一套", 4.963, 5.238], ["法律", 5.25, 5.738]]}, {"s": "它講究權利平等，講話的自由也一樣平等。", "start": 222.792, "end": 226.43, "w": [["它", 0.0, 0.188], ["講究", 0.213, 0.525], ["權利", 0.562, 0.887], ["平等", 0.925, 1.412], ["講話的", 1.7, 2.2], ["自由", 2.25, 2.65], ["也", 2.7, 2.838], ["一樣", 2.863, 3.137], ["平等", 3.175, 3.637]]}, {"s": "而最好的王道，最看重的就是被統治者的自由。", "start": 227.33, "end": 231.105, "w": [["而", 0.0, 0.125], ["最", 0.188, 0.338], ["好的", 0.363, 0.625], ["王道", 0.662, 1.162], ["最", 1.438, 1.55], ["看重的", 1.6, 2.125], ["就是", 2.15, 2.425], ["被", 2.45, 2.575], ["統治者的", 2.588, 3.225], ["自由", 3.263, 3.775]]}]}, {"t": "馬克西姆斯教我自我約束，不被任何東西牽著走。就算生病，也一樣開朗，溫和跟莊重拿捏得剛好。大家都相信他心口如一，說什麼就是心裡想什麼。他不慌張、不拖延，也不用笑來掩飾不痛快。他隨時準備原諒別人，身上沒有一絲虛假。沒有人覺得被他瞧不起，也沒人敢自以為比他強。", "src": [15, 18], "start": 232.042, "end": 260.455, "sents": [{"s": "馬克西姆斯教我自我約束，不被任何東西牽著走。", "start": 232.042, "end": 236.155, "w": [["馬克", 0.0, 0.363], ["西", 0.375, 0.575], ["姆", 0.6, 0.75], ["斯", 0.762, 0.975], ["教", 1.012, 1.2], ["我", 1.213, 1.338], ["自我", 1.387, 1.675], ["約束", 1.688, 2.213], ["不", 2.45, 2.562], ["被", 2.562, 2.725], ["任何", 2.738, 3.075], ["東西", 3.088, 3.4], ["牽", 3.438, 3.613], ["著", 3.662, 3.8], ["走", 3.838, 4.113]]}, {"s": "就算生病，也一樣開朗，溫和跟莊重拿捏得剛好。", "start": 237.08, "end": 241.292, "w": [["就算", 0.0, 0.375], ["生病", 0.4, 0.863], ["也", 1.138, 1.25], ["一樣", 1.287, 1.525], ["開朗", 1.588, 2.062], ["溫和", 2.363, 2.675], ["跟", 2.725, 2.812], ["莊重", 2.875, 3.25], ["拿捏", 3.263, 3.575], ["得", 3.588, 3.688], ["剛好", 3.738, 4.213]]}, {"s": "大家都相信他心口如一，說什麼就是心裡想什麼。", "start": 242.192, "end": 246.38, "w": [["大家", 0.0, 0.35], ["都", 0.375, 0.475], ["相信", 0.487, 0.825], ["他", 0.887, 1.1], ["心口如", 1.1, 1.65], ["一", 1.675, 1.963], ["說", 2.225, 2.425], ["什麼", 2.45, 2.8], ["就是", 2.85, 3.075], ["心裡", 3.112, 3.463], ["想", 3.487, 3.675], ["什麼", 3.7, 4.188]]}, {"s": "他不慌張、不拖延，也不用笑來掩飾不痛快。", "start": 247.28, "end": 251.093, "w": [["他", 0.0, 0.2], ["不", 0.212, 0.312], ["慌張", 0.35, 0.875], ["不", 1.062, 1.212], ["拖延", 1.25, 1.737], ["也", 2.012, 2.125], ["不用", 2.175, 2.412], ["笑", 2.438, 2.637], ["來", 2.662, 2.787], ["掩飾", 2.825, 3.112], ["不", 3.162, 3.262], ["痛快", 3.287, 3.812]]}, {"s": "他隨時準備原諒別人，身上沒有一絲虛假。", "start": 252.03, "end": 255.718, "w": [["他", 0.0, 0.2], ["隨時", 0.212, 0.6], ["準備", 0.625, 0.975], ["原諒", 1.012, 1.325], ["別人", 1.375, 1.85], ["身上", 2.175, 2.562], ["沒有", 2.562, 2.812], ["一絲", 2.837, 3.137], ["虛假", 3.162, 3.688]]}, {"s": "沒有人覺得被他瞧不起，也沒人敢自以為比他強。", "start": 256.605, "end": 260.455, "w": [["沒有", 0.0, 0.35], ["人", 0.35, 0.462], ["覺得", 0.512, 0.788], ["被", 0.825, 0.913], ["他", 0.938, 1.113], ["瞧不起", 1.113, 1.8], ["也", 2.05, 2.163], ["沒", 2.2, 2.363], ["人", 2.375, 2.475], ["敢", 2.55, 2.663], ["自以為", 2.712, 3.15], ["比", 3.175, 3.288], ["他", 3.337, 3.525], ["強", 3.525, 3.85]]}]}, {"t": "我在父親身上看到脾氣的溫和。他仔細考量後下的決定，就絕不動搖。他不愛虛榮，愛做事又肯堅持到底。有人為公眾利益提建議，他都願意聽。他把自己看得跟其他公民一樣，從不抬高。朋友不必硬陪他吃飯出門，他也不計較。", "src": [19, 21], "start": 261.418, "end": 284.605, "sents": [{"s": "我在父親身上看到脾氣的溫和。", "start": 261.418, "end": 263.968, "w": [["我", 0.0, 0.125], ["在", 0.163, 0.312], ["父親", 0.325, 0.65], ["身上", 0.712, 1.1], ["看到", 1.175, 1.488], ["脾氣的", 1.512, 1.988], ["溫和", 2.0, 2.55]]}, {"s": "他仔細考量後下的決定，就絕不動搖。", "start": 264.88, "end": 268.093, "w": [["他", 0.0, 0.213], ["仔細", 0.225, 0.538], ["考量", 0.588, 0.963], ["後下的", 1.0, 1.5], ["決定", 1.538, 1.963], ["就", 2.238, 2.375], ["絕不", 2.425, 2.7], ["動搖", 2.725, 3.213]]}, {"s": "他不愛虛榮，愛做事又肯堅持到底。", "start": 269.018, "end": 272.043, "w": [["他", 0.0, 0.2], ["不", 0.212, 0.337], ["愛", 0.35, 0.512], ["虛榮", 0.537, 1.075], ["愛", 1.325, 1.462], ["做事", 1.5, 1.775], ["又", 1.775, 1.95], ["肯", 2.0, 2.125], ["堅持", 2.188, 2.537], ["到底", 2.537, 3.025]]}, {"s": "有人為公眾利益提建議，他都願意聽。", "start": 272.942, "end": 275.893, "w": [["有", 0.0, 0.175], ["人為", 0.175, 0.45], ["公眾", 0.513, 0.838], ["利益", 0.863, 1.088], ["提", 1.163, 1.275], ["建", 1.35, 1.5], ["議", 1.562, 1.85], ["他", 2.113, 2.263], ["都", 2.3, 2.4], ["願意", 2.425, 2.675], ["聽", 2.75, 2.95]]}, {"s": "他把自己看得跟其他公民一樣，從不抬高。", "start": 276.855, "end": 280.343, "w": [["他", 0.0, 0.212], ["把", 0.212, 0.4], ["自己", 0.425, 0.675], ["看", 0.75, 0.9], ["得", 0.913, 1.025], ["跟", 1.1, 1.175], ["其他", 1.225, 1.575], ["公民", 1.637, 1.9], ["一樣", 1.962, 2.413], ["從不", 2.7, 2.988], ["抬高", 3.025, 3.488]]}, {"s": "朋友不必硬陪他吃飯出門，他也不計較。", "start": 281.268, "end": 284.605, "w": [["朋友", 0.0, 0.35], ["不必", 0.375, 0.675], ["硬", 0.688, 0.787], ["陪", 0.837, 1.012], ["他", 1.037, 1.225], ["吃飯", 1.237, 1.562], ["出門", 1.612, 2.1], ["他", 2.387, 2.562], ["也", 2.575, 2.688], ["不計較", 2.737, 3.337]]}]}, {"t": "他做事總是仔細查問，很有耐性，不會只看表面就停下。他能預見很遠的事，卻不張揚。群眾的喝采跟奉承，他都馬上壓下來。他錢管得好，就算被人責怪也耐著性子承受。他對神明不迷信，也不靠送禮討好去籠絡人。真正的哲學家他都尊敬，假的他不責備，也不會被牽著走。", "src": [21, 23], "start": 285.53, "end": 313.718, "sents": [{"s": "他做事總是仔細查問，很有耐性，不會只看表面就停下。", "start": 285.53, "end": 290.668, "w": [["他", 0.0, 0.2], ["做事", 0.238, 0.562], ["總是", 0.587, 1.0], ["仔細", 1.025, 1.325], ["查問", 1.363, 1.887], ["很", 2.212, 2.35], ["有", 2.412, 2.512], ["耐性", 2.562, 3.087], ["不會", 3.35, 3.613], ["只", 3.65, 3.775], ["看", 3.85, 4.0], ["表面", 4.037, 4.375], ["就", 4.425, 4.55], ["停下", 4.587, 5.137]]}, {"s": "他能預見很遠的事，卻不張揚。", "start": 291.567, "end": 294.305, "w": [["他", 0.0, 0.213], ["能", 0.213, 0.35], ["預見", 0.388, 0.713], ["很", 0.763, 0.913], ["遠的", 0.975, 1.275], ["事", 1.288, 1.625], ["卻", 1.9, 2.075], ["不", 2.088, 2.213], ["張揚", 2.263, 2.738]]}, {"s": "群眾的喝采跟奉承，他都馬上壓下來。", "start": 295.218, "end": 298.493, "w": [["群眾的", 0.0, 0.55], ["喝采", 0.575, 0.95], ["跟", 1.012, 1.113], ["奉承", 1.162, 1.662], ["他", 1.925, 2.1], ["都", 2.15, 2.25], ["馬上", 2.25, 2.6], ["壓下", 2.625, 3.025], ["來", 3.037, 3.275]]}, {"s": "他錢管得好，就算被人責怪也耐著性子承受。", "start": 299.418, "end": 303.343, "w": [["他", 0.0, 0.188], ["錢", 0.188, 0.363], ["管", 0.413, 0.55], ["得", 0.562, 0.688], ["好", 0.712, 1.038], ["就算", 1.288, 1.613], ["被", 1.625, 1.775], ["人", 1.788, 1.925], ["責怪", 2.0, 2.425], ["也", 2.462, 2.637], ["耐著", 2.675, 2.962], ["性子", 2.975, 3.325], ["承受", 3.337, 3.925]]}, {"s": "他對神明不迷信，也不靠送禮討好去籠絡人。", "start": 304.255, "end": 307.93, "w": [["他", 0.0, 0.2], ["對", 0.225, 0.338], ["神明", 0.363, 0.7], ["不", 0.738, 0.863], ["迷信", 0.863, 1.325], ["也", 1.6, 1.738], ["不", 1.775, 1.85], ["靠", 1.9, 2.088], ["送禮", 2.1, 2.45], ["討好", 2.5, 2.838], ["去", 2.875, 3.013], ["籠絡", 3.062, 3.413], ["人", 3.425, 3.675]]}, {"s": "真正的哲學家他都尊敬，假的他不責備，也不會被牽著走。", "start": 308.918, "end": 313.718, "w": [["真正的", 0.0, 0.475], ["哲學家", 0.512, 1.075], ["他", 1.075, 1.25], ["都", 1.288, 1.363], ["尊敬", 1.425, 1.863], ["假的", 2.163, 2.425], ["他", 2.462, 2.625], ["不", 2.675, 2.738], ["責備", 2.788, 3.262], ["也", 3.538, 3.663], ["不會", 3.688, 3.975], ["被", 3.988, 4.113], ["牽", 4.137, 4.312], ["著", 4.363, 4.5], ["走", 4.538, 4.8]]}]}, {"t": "他跟人交談很輕鬆，照顧健康也很合理，很少需要看醫生。別人有才能，他一點都不嫉妒，還幫他們得到應得的名聲。他不喜歡變動，喜歡待在同樣的地方做同樣的事。他的祕密很少，而且只跟公事有關。公共建設、給人民的捐贈，他辦得又謹慎又節省。他不講究吃穿，也不在意奴隸長得漂不漂亮。", "src": [24, 27], "start": 314.518, "end": 344.118, "sents": [{"s": "他跟人交談很輕鬆，照顧健康也很合理，很少需要看醫生。", "start": 314.518, "end": 319.718, "w": [["他", 0.0, 0.2], ["跟", 0.25, 0.363], ["人", 0.375, 0.5], ["交談", 0.562, 0.925], ["很", 0.963, 1.075], ["輕鬆", 1.137, 1.7], ["照顧", 1.987, 2.262], ["健康", 2.312, 2.688], ["也", 2.762, 2.887], ["很", 2.938, 3.062], ["合理", 3.112, 3.625], ["很", 3.937, 4.062], ["少", 4.1, 4.288], ["需要", 4.312, 4.613], ["看", 4.65, 4.788], ["醫生", 4.8, 5.2]]}, {"s": "別人有才能，他一點都不嫉妒，還幫他們得到應得的名聲。", "start": 320.68, "end": 325.368, "w": [["別人", 0.0, 0.3], ["有", 0.35, 0.462], ["才能", 0.5, 0.975], ["他", 1.263, 1.45], ["一點", 1.45, 1.712], ["都", 1.737, 1.862], ["不", 1.862, 1.975], ["嫉妒", 2.025, 2.5], ["還", 2.8, 2.95], ["幫", 2.962, 3.112], ["他們", 3.15, 3.425], ["得到", 3.475, 3.763], ["應", 3.775, 3.888], ["得的", 3.937, 4.212], ["名聲", 4.225, 4.687]]}, {"s": "他不喜歡變動，喜歡待在同樣的地方做同樣的事。", "start": 326.33, "end": 330.418, "w": [["他", 0.0, 0.2], ["不", 0.213, 0.3], ["喜歡", 0.325, 0.7], ["變動", 0.725, 1.188], ["喜歡", 1.45, 1.85], ["待在", 1.875, 2.162], ["同樣的", 2.175, 2.625], ["地方", 2.638, 3.0], ["做", 3.088, 3.225], ["同樣的", 3.25, 3.738], ["事", 3.75, 4.088]]}, {"s": "他的祕密很少，而且只跟公事有關。", "start": 331.355, "end": 334.418, "w": [["他的", 0.0, 0.337], ["祕密", 0.337, 0.637], ["很", 0.688, 0.85], ["少", 0.9, 1.238], ["而且", 1.438, 1.837], ["只", 1.85, 1.988], ["跟", 2.05, 2.163], ["公事", 2.238, 2.562], ["有關", 2.575, 3.062]]}, {"s": "公共建設、給人民的捐贈，他辦得又謹慎又節省。", "start": 335.368, "end": 339.593, "w": [["公共", 0.0, 0.35], ["建設", 0.4, 0.938], ["給", 1.213, 1.338], ["人民的", 1.35, 1.75], ["捐贈", 1.788, 2.262], ["他", 2.562, 2.738], ["辦", 2.75, 2.875], ["得", 2.913, 3.012], ["又", 3.038, 3.163], ["謹慎", 3.225, 3.55], ["又", 3.588, 3.688], ["節省", 3.738, 4.225]]}, {"s": "他不講究吃穿，也不在意奴隸長得漂不漂亮。", "start": 340.53, "end": 344.118, "w": [["他", 0.0, 0.2], ["不", 0.212, 0.3], ["講究", 0.35, 0.662], ["吃", 0.7, 0.863], ["穿", 0.887, 1.225], ["也", 1.512, 1.625], ["不在意", 1.662, 2.037], ["奴", 2.087, 2.212], ["隸", 2.275, 2.363], ["長", 2.425, 2.6], ["得", 2.637, 2.75], ["漂", 2.8, 2.95], ["不", 2.962, 3.075], ["漂亮", 3.113, 3.587]]}]}, {"t": "他身上沒有嚴厲、沒有記恨、沒有粗暴。他把每件事一件一件分開檢視，好像時間很多，一點都不慌。人家記蘇格拉底那句話，用在他身上也剛好。很多人太軟弱，有些東西戒不掉，享受起來又過頭。他卻是既戒得掉，也能好好享受。能兩邊都拿捏住，這才是完美靈魂的印記。", "src": [28, 29], "start": 345.067, "end": 373.418, "sents": [{"s": "他身上沒有嚴厲、沒有記恨、沒有粗暴。", "start": 345.067, "end": 348.63, "w": [["他", 0.0, 0.2], ["身上", 0.213, 0.613], ["沒有", 0.613, 0.9], ["嚴厲", 0.938, 1.45], ["沒有", 1.675, 1.975], ["記恨", 2.025, 2.5], ["沒有", 2.75, 3.038], ["粗暴", 3.062, 3.562]]}, {"s": "他把每件事一件一件分開檢視，好像時間很多，一點都不慌。", "start": 349.53, "end": 354.768, "w": [["他", 0.0, 0.213], ["把", 0.213, 0.388], ["每", 0.388, 0.55], ["件", 0.613, 0.738], ["事